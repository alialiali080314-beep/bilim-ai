#!/bin/bash
# BilimOS — GNOME default settings via dconf

set -e

DCONF_PROFILE_DIR="/etc/dconf/profile"
DCONF_DB_DIR="/etc/dconf/db/bilimos.d"

mkdir -p "$DCONF_PROFILE_DIR" "$DCONF_DB_DIR"

# dconf profile
cat > "${DCONF_PROFILE_DIR}/user" <<EOF
user-db:user
system-db:bilimos
EOF

# GNOME appearance settings
cat > "${DCONF_DB_DIR}/00-appearance" <<EOF
[org/gnome/desktop/interface]
gtk-theme='Adwaita-dark'
icon-theme='Papirus-Dark'
cursor-theme='Adwaita'
font-name='Noto Sans 11'
document-font-name='Noto Sans 11'
monospace-font-name='Noto Sans Mono 11'
color-scheme='prefer-dark'
show-battery-percentage=true
clock-show-date=true
clock-show-weekday=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/bilimos/wallpaper.jpg'
picture-uri-dark='file:///usr/share/bilimos/wallpaper-dark.jpg'
picture-options='zoom'
primary-color='#1a1a2e'
secondary-color='#16213e'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/bilimos/wallpaper-dark.jpg'
lock-enabled=true
lock-delay=uint32 300

[org/gnome/shell]
favorite-apps=['firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'libreoffice-startcenter.desktop', 'bilimos-installer.desktop']
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com', 'dash-to-dock@micxgx.gmail.com']

[org/gnome/mutter]
edge-tiling=true
dynamic-workspaces=true

[org/gnome/desktop/wm/preferences]
button-layout=':minimize,maximize,close'
num-workspaces=4

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-timeout=1800
sleep-inactive-battery-timeout=900
power-button-action='suspend'
EOF

# GNOME language / input
cat > "${DCONF_DB_DIR}/01-input" <<EOF
[org/gnome/desktop/input-sources]
sources=[('xkb', 'ru'), ('xkb', 'us')]
xkb-options=['grp:alt_shift_toggle', 'grp_led:scroll']
EOF

# Update dconf database
dconf update 2>/dev/null || true

echo "GNOME settings applied."
